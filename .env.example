# Octop Pet — optional local overrides (copy to .env if your tooling reads it).
# The app stores runtime config in the Tauri app data directory (config.json)
# and secrets in the OS keyring — not in .env.

# Example: document the Octop server you test against (for humans / scripts only)
# OCTOP_BASE_URL=http://127.0.0.1:8088
